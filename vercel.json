{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "usepawd.com"
        }
      ],
      "destination": "https://www.usepawd.com/$1",
      "permanent": true
    },
    {
      "source": "/ig",
      "destination": "https://dash.usepawd.com/go/ig",
      "permanent": false
    }
  ]
}
